#!/usr/bin/env bash
SCRIPT_NAME="$(basename "$0")"

DEFAULT_ULIMIT_NUM=5000
DEFAULT_NMAP_OPTIONS="-Pn -sV"

ulimit_num="$DEFAULT_ULIMIT_NUM"
nmap_options="$DEFAULT_NMAP_OPTIONS"
address=""

usage() {
    cat <<EOF
Usage: $SCRIPT_NAME -a Address [OPTIONS] -- [rustscan options]

Options:
  --addresses value, -a value  Target Addresses (required)
  --ulimit value, -u value     Set ulimit (default: $DEFAULT_ULIMIT_NUM)
  --nmaps value, -n value      Nmap options (default: $DEFAULT_NMAP_OPTIONS)
  --help, -h                   Show this help
EOF
    exit 2
}

while [[ "$#" -gt 0 ]]; do
    case "$1" in
        --addresses|-a)
            if [[ -n "$2" && "${2:0:1}" != "-" ]]; then
                address="$2"
                shift 2
            else
                echo "Error: --addresses, -a requires a value"
                usage
            fi
            ;;
        --ulimit|-u)
            if [[ -n "$2" && "${2:0:1}" != "-" ]]; then
                ulimit_num="$2"
                shift 2
            else
                echo "Error: --ulimit, -u requires a value"
                usage
            fi
            ;;
        --nmaps|-n)
            if [[ -n "$2" ]]; then
                nmap_options="$2"
                shift 2
            else
                echo "Error: --nmaps, -n requires a value"
                usage
            fi
            ;;
        --help|-h)
            usage
            ;;
        --)
            shift
            break
            ;;
        *)
            echo "Error: Unknown option: $1"
            usage
            ;;
    esac
done

if [[ -z "$address" ]]; then
    echo "Error: --addresses, -a is required"
    usage
fi

cmd=(
    rustscan
    -a "$address"
    -u "$ulimit_num"
)

cmd+=("$@" -- $nmap_options)

printf 'Run: %s\n\n' "${cmd[*]}"
exec "${cmd[@]}"